hierarchical inheritance:- 
class Animal:
    def eat(self):
        print("This Animal eats food....") 
        
class Dog(Animal):
    def sound(self):
        print("Dog will bark....") 

class Cat(Animal):
    def sound(self):
        print("Cat will meow....") 
        
class Lion(Animal): 
    def sound(self):
        print("Lion will Roar") 

myLion = Lion() 
myLion.sound() 

myCat = Cat()
myCat.sound()

