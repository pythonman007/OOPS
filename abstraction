Note :- If there are no concrete methods in abstract class we call it as interface . In python conceptually it is interface but practically we call abstract base classes .
from abc import ABC,abstractmethod 

class Animal(ABC):   #  abstract class 
    
    @abstractmethod
    def eat(self):  
        pass 

    @abstractmethod      
